# Floci UI is an independently versioned upstream dependency.
# Keep only the lab-specific Docker Compose override in this repository.
/floci-ui/

# Terraform working data and state must remain local.
**/.terraform/
**/*.tfstate
**/*.tfstate.*
**/crash.log
**/crash.*.log
**/*.tfplan

# Local certificates are generated by Floci-AZ.
**/floci-az.crt
